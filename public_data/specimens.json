    ],
    "site_id": "A003"
  },
  {
    "specimen_id": "MDR260530-02",
    "classification": "未同定",
    "scientific_name": "未同定",
    "common_name": "未同定",
    "formation": "中部蝦夷層群",
    "age": "約9000万年前",
    "collection_date": "2026-05-30 00:00:00",
    "notes": "化石が含まれていると思われるノジュール。ノジュールとは、地層（泥岩や砂岩など）の中で、化石や有機物を核として周囲の鉱物成分（炭酸カルシウムなど）が固まってできた、丸みを帯びた硬い岩塊のことである。ノジュール中では風化の影響を受けにくく、状態の良い化石が見つかることがある。北海道で化石を発掘したい人は、まずノジュールを探せるようになることが重要になってくると言えよう（顧問阿部は見分けがつくようになるまで４年もかかってしまった）",
    "image": "images/MDR260530-02.jpg",
    "thumbnail": "images/thumbs/MDR260530-02.jpg",
